  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CadAgent.View\CadAgent.View.csproj" />
    <ProjectReference Include="..\..\src\CadAgent.Data\CadAgent.Data.csproj" />
    <ProjectReference Include="..\..\src\CadAgent.Core\CadAgent.Core.csproj" />
  </ItemGroup>

</Project>
