<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!-- 视觉接线 T2：RenderSnapshotProvider 生产 headless 入口（离屏 Skia PNG）平台初始化 -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadAgent.Core\CadAgent.Core.csproj" />
    <ProjectReference Include="..\CadAgent.Data\CadAgent.Data.csproj" />
    <!-- 视觉接线 T3：vision-scan headless 入口生产路径 OpenAiClient/DpapiKeyProtector（Llm 仅引用 Core，无环） -->
    <ProjectReference Include="..\CadAgent.Llm\CadAgent.Llm.csproj" />
    <!-- 审图报告导出（View「导出报告」与 CLI report export 共用 ReviewReportExporter） -->
    <ProjectReference Include="..\CadAgent.Report\CadAgent.Report.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CadAgent.View.Tests" />
    <!-- 项3 T7 性能工具（手工基线）：只读消费 SetQualityForTests/BaseRenderCount 等既有 internal seam
         以实测「交互档失效重建」；不开新 public seam，产品可见性不变。 -->
    <InternalsVisibleTo Include="CadAgent.PerfBaseline" />
  </ItemGroup>

</Project>
