<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CadAgent.Core\CadAgent.Core.csproj" />
    <ProjectReference Include="..\CadAgent.Data\CadAgent.Data.csproj" />
    <!-- View 仅输出复制（计划4 T1 裁定）：view 命令经 dotnet CadAgent.View.dll 进程拉起，
         Cli 代码不 using Avalonia——此引用只为把 View 及其依赖复制到 Cli 输出目录。 -->
    <ProjectReference Include="..\CadAgent.View\CadAgent.View.csproj" />
    <ProjectReference Include="..\CadAgent.Llm\CadAgent.Llm.csproj" />
    <ProjectReference Include="..\CadAgent.Adapters.Zwcad\CadAgent.Adapters.Zwcad.csproj" />
    <ProjectReference Include="..\CadAgent.Adapters.Acad\CadAgent.Adapters.Acad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CadAgent.Cli.Tests" />
    <InternalsVisibleTo Include="CadAgent.Adapters.Zwcad.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="vendor-support.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
